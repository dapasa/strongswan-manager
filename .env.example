# =============================================================================
# strongswan-manager — Environment Variables
# Copy to .env and fill in real values before running.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_NAME=strongswan-manager
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# -- Database -----------------------------------------------------------------
# Must use postgresql+asyncpg:// scheme. The default connects to the docker-compose db service.
DATABASE_URL=postgresql+asyncpg://vpnmanager:changeme@db:5432/vpnmanager
POSTGRES_PASSWORD=changeme
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -- OIDC / Auth --------------------------------------------------------------
# OIDC issuer URL (e.g., AWS IAM Identity Center)
OIDC_ISSUER_URL=https://your-idp.example.com
# OIDC audience claim the API validates against
OIDC_AUDIENCE=your-client-id

# -- AWS / S3 -----------------------------------------------------------------
AWS_REGION=us-east-1
# S3 bucket storing the generated ipsec.conf
S3_BUCKET=your-ipsec-bucket
# Key (path) within the bucket
S3_IPSEC_KEY=ipsec/ipsec.conf

# -- SSM / VPN Instances ------------------------------------------------------
# EC2 Name tags used to locate the VPN instances via SSM
VPN_PRIMARY_INSTANCE_NAME=vpn-primary
VPN_SECONDARY_INSTANCE_NAME=vpn-secondary
SSM_COMMAND_TIMEOUT=60

# -- Git / Terragrunt ---------------------------------------------------------
# GitHub HTTPS URL for the infrastructure repo (without token)
GITHUB_REPO_URL=https://github.com/your-org/infra-repo.git
# GitHub PAT with repo access
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Local clone path inside the container (must match the repos volume mount)
GIT_REPO_PATH=/repos/infra
GIT_BRANCH=main
# Path to vpn_routes.json relative to the git repo root
TERRAGRUNT_ROUTES_PATH=environments/prod/vpn/vpn_routes.json
# Terragrunt working directory (absolute path inside the container)
TERRAGRUNT_WORKING_DIR=/repos/infra/environments/prod/vpn
TERRAGRUNT_TIMEOUT=300

# -- CORS ---------------------------------------------------------------------
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]
