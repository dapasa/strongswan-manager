# =============================================================================
# strongswan-manager — Environment Variables
# Copy to .env and fill in real values before running.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_NAME=strongswan-manager
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# -- Database -----------------------------------------------------------------
# Must use postgresql+asyncpg:// scheme. The default connects to the docker-compose db service.
DATABASE_URL=postgresql+asyncpg://vpnmanager:changeme@db:5432/vpnmanager
POSTGRES_PASSWORD=changeme
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# -- Authentication -----------------------------------------------------------
# Mode: 'local' (username/password JWT, default) or 'oidc' (external IdP).
AUTH_MODE=local

# Required when AUTH_MODE=local. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# JWT lifetime in minutes (default 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# -- OIDC (only needed when AUTH_MODE=oidc) -----------------------------------
# OIDC_ISSUER_URL=https://your-idp.example.com
# OIDC_AUDIENCE=your-client-id

# -- AWS ----------------------------------------------------------------------
AWS_REGION=us-east-1

# -- AWS Cross-Account (optional) ---------------------------------------------
# If the .env has credentials for a master/CI account but SSM/EC2/KMS resources
# live in a different (target) account, set this to assume a role there.
# Leave commented out to use default credentials directly.
# AWS_ASSUME_ROLE_ARN=arn:aws:iam::123456789012:role/TerraformAdminRole

# -- KMS — PSK encryption -----------------------------------------------------
# KMS key ID or alias used to encrypt tunnel PSKs stored in the database.
# The manager needs kms:Encrypt and kms:Decrypt on this key.
KMS_PSK_KEY_ID=alias/strongswan-psk

# -- Database URL from SSM (optional) -----------------------------------------
# If set, DATABASE_URL is read from this SSM Parameter Store name at startup
# (SecureString, decrypted). Leave unset to use DATABASE_URL directly.
# SSM_DATABASE_URL_PARAMETER=/strongswan-manager/prod/database-url

# -- SSM / VPN Instances ------------------------------------------------------
# EC2 Name tags used to locate the VPN instances via SSM
VPN_PRIMARY_INSTANCE_NAME=vpn-primary
VPN_SECONDARY_INSTANCE_NAME=vpn-secondary
SSM_COMMAND_TIMEOUT=60

# -- SSH Command Execution ----------------------------------------------------
SSH_COMMAND_TIMEOUT=30

# -- VPN Server Remote Paths (optional — defaults shown) ----------------------
# Remote directory for StrongSwan connection config files (.conf)
# VPN_CONF_DIR=/opt/strongswan/config/connections
# Remote directory for StrongSwan secrets files (.secrets)
# VPN_SECRETS_DIR=/opt/strongswan/config/secrets

# -- CORS ---------------------------------------------------------------------
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# -- VPC Route Management (sc-31774) ------------------------------------------
# S3 bucket that holds failover/config.yaml (eip_allocation_id, route_table_ids, …)
STRONGSWAN_CONFIG_BUCKET=dev-strongswan-config

# Comma-separated route table IDs this manager may write to.
# Empty or unset = route-write feature disabled.
MANAGED_ROUTE_TABLE_IDS=["rtb-xxxxxxxxxxxxxxxxx","rtb-yyyyyyyyyyyyyyyyy"]

# -- Tier 2 Elevated Access (Shortcut integration) ----------------------------
# Shortcut API token — provide via one of:
#   a) SHORTCUT_API_TOKEN (env var, local dev / CI)
#   b) SHORTCUT_TOKEN_SECRET_ARN (AWS Secrets Manager, production)
#
# When SHORTCUT_TOKEN_SECRET_ARN is set, the token is read from Secrets Manager
# using the EC2 instance role (dev-strongswan-manager-role, default credential
# chain — no role assumption). The value is cached for 1 hour so rotation is
# picked up without a restart.
# NOTE: the IAM grant (secretsmanager:GetSecretValue on the secret ARN) lives in
# the infrastructure repo and is applied separately; this setting only tells the
# manager where to look.
#
# Leave both empty to disable the elevated access request feature entirely.
SHORTCUT_API_TOKEN=
# SHORTCUT_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:941644385943:secret:master/access-grants/shortcut-token-N7nCVh

# Shortcut workflow state IDs for the access-request lifecycle
SHORTCUT_WF_REQUESTED_ID=500006959
SHORTCUT_WF_APPROVED_ID=500006960
SHORTCUT_WF_COMPLETED_ID=500006961
SHORTCUT_WF_REJECTED_ID=500006962

# Comma-separated Shortcut member UUIDs authorized to approve access requests.
# These members must NOT be the requester/grantee of the same request.
# Defaults to the current leads (see app/config.py); set it only to override that list.
# SHORTCUT_LEAD_MEMBER_IDS=

# Epic and group (team) the access-request stories are filed under. Defaults: the
# Privileged Access Grants epic and the Engineers team. The stories carry no project:
# the Access Requests workflow belongs to no project and Shortcut rejects one (422).
# SHORTCUT_EPIC_ID=29211
# SHORTCUT_GROUP_ID=615256ca-3f27-4a13-88c0-d82b192ab194

# Label applied to access-request stories: identifies the deployment environment
# (used in the story title so approvers know which environment they're approving)
SHORTCUT_ENVIRONMENT=dev

# How often (seconds) the access poller checks open requests against Shortcut
SHORTCUT_POLL_INTERVAL_SECONDS=120
